# ============================================
# Reddit Ops Console - Environment Variables
# ============================================
# Copy this file to apps/backend/.env
# Then fill in your API keys

# === Database ===
# PostgreSQL (Recommended for production)
DATABASE_URL=postgresql+asyncpg://postgres:postgres123@localhost:5432/reddit_ops

# SQLite (Development only - uncomment below and comment out PostgreSQL line)
# DATABASE_URL=sqlite+aiosqlite:///./data/reddit_ops.db

# === Backend Server ===
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
DEBUG=false

# === Frontend ===
# Set this in apps/frontend/.env.local if needed
# NEXT_PUBLIC_API_URL=http://localhost:8000

# ============================================
# REQUIRED API KEYS
# ============================================

# === Apify (Required for Problem Discovery & Multi-Source Validation) ===
# Get your token: https://console.apify.com/account/integrations
# Cost: ~$0.50 per 1000 search results
# Note: Some actors (LinkedIn, Google News) require monthly rental
APIFY_API_TOKEN=

# === OpenRouter (Required for AI Analysis) ===
# Get your key: https://openrouter.ai/keys
# Cost: ~$0.003 per problem analysis (using Claude)
OPENROUTER_API_KEY=

# ============================================
# OPTIONAL API KEYS
# ============================================

# === Resend (For Email Digests) ===
# Get your key: https://resend.com/api-keys
# Free tier: 100 emails/day
RESEND_API_KEY=
RESEND_FROM_EMAIL=Market Insights <insights@resend.dev>

# ============================================
# RATE LIMITING & PERFORMANCE
# ============================================

# Apify rate limiting (requests per minute)
APIFY_RATE_LIMIT=10

# Apify cache TTL in seconds (default: 24 hours)
APIFY_CACHE_TTL=86400

# Maximum concurrent scrape jobs
MAX_CONCURRENT_JOBS=3

# ============================================
# LEGACY / OPTIONAL
# ============================================

# Discord webhook for job notifications
# DISCORD_WEBHOOK_URL=

# Telegram bot for notifications
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=

# Enable basic authentication
AUTH_ENABLED=false
# AUTH_PASSWORD=changeme
